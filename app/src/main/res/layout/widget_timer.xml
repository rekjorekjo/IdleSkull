<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/widget_title_row"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_skull"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skull_foreground_v2" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:fontFamily="@font/fusion_pixel_12px_proportional"
            android:text="摆烂计时"
            android:textColor="#101010"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/fusion_pixel_12px_proportional"
        android:text="等待摆烂"
        android:textColor="#595959"
        android:textSize="10sp" />

    <Chronometer
        android:id="@+id/widget_chronometer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fontFamily="@font/fusion_pixel_12px_proportional"
        android:gravity="center_vertical"
        android:text="00:00:00"
        android:textColor="#101010"
        android:textSize="26sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_light_primary"
            android:fontFamily="@font/fusion_pixel_12px_proportional"
            android:gravity="center"
            android:text="开始"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <Space
            android:id="@+id/widget_gap"
            android:layout_width="6dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_light_secondary"
            android:fontFamily="@font/fusion_pixel_12px_proportional"
            android:gravity="center"
            android:text="结束"
            android:textColor="#101010"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
